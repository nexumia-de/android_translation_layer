<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  Runtime permissions without a portal, for every app in its own ATL Flatpak
  (docs/hardening-roadmap.md, phase 4). Same rules for changes as
  de.nexumia.atl.Installer: the interface only grows and Version says how far.

  The caller is the app whose sandbox makes the call. permission is an Android
  permission from the table in permissions.c or ATL's own "atl.google-services";
  others fail with InvalidArgs, and callers outside an ATL app Flatpak with
  AccessDenied. A permission the APK does not request is always "no".

  Version 1: Check and Request.
  Version 3: Review (version 2 is OpenAppInfo, #88).
  Version 2: OpenAppInfo.
  Version 4: Authenticators, VerifyFingerprint, ConfirmCredential, CancelAuthentication,
             DeviceLocked (docs/keystore-auth.md).
-->
<node>
  <interface name="de.nexumia.atl.Permissions">
    <property name="Version" type="u" access="read"/>

    <!-- The stored answer without asking: "yes", "no" or "ask" (not answered yet). -->
    <method name="Check">
      <arg direction="in" name="permission" type="s"/>
      <arg direction="out" name="answer" type="s"/>
    </method>

    <!--
      Asks the user with the desktop's access dialog unless the answer is already
      "yes" or the user said no twice, stores it, and returns "yes" or "no".
    -->
    <method name="Request">
      <arg direction="in" name="permission" type="s"/>
      <arg direction="out" name="answer" type="s"/>
    </method>

    <!--
      For apps made for Android before 6 (target SDK or SDK_INT below 23), which never ask:
      once, one review of the caller's dangerous permissions, each off by default, stored like
      the other answers. Returns the answers ("yes" or "no") of the reviewed permissions the APK
      requests; after the review, without a dialog.
    -->
    <method name="Review">
      <arg direction="out" name="answers" type="a{ss}"/>
    </method>
    <!-- Opens the calling app's App info on the host (the launcher's "App info" action). -->
    <method name="OpenAppInfo"/>

    <!--
      What can confirm the owner now, as BiometricManager.Authenticators bits: BIOMETRIC_STRONG
      (0x000F) with an enrolled fingerprint, DEVICE_CREDENTIAL (0x8000) when the polkit action
      de.nexumia.atl.confirm-credential is installed. enrollment changes when a finger is added
      or removed ("" without fingerprints).
    -->
    <method name="Authenticators">
      <arg direction="out" name="available" type="u"/>
      <arg direction="out" name="enrollment" type="s"/>
    </method>

    <!--
      One fingerprint attempt; the app shows its own "touch the sensor" dialog meanwhile.
      "match", "no-match", "retry" (bad press, try again), "lockout" (five failures in a row,
      30 seconds for every app), "canceled", "unavailable" (no fingerprint, or the sensor is
      busy) or "error". One confirmation per app at a time.
    -->
    <method name="VerifyFingerprint">
      <arg direction="out" name="result" type="s"/>
    </method>

    <!--
      Asks for the owner's password in the desktop's polkit prompt: "yes", "no" (wrong or
      dismissed) or "unavailable" (action not installed).
    -->
    <method name="ConfirmCredential">
      <arg direction="out" name="result" type="s"/>
    </method>

    <!-- Ends the caller's running VerifyFingerprint ("canceled") or ConfirmCredential ("no"). -->
    <method name="CancelAuthentication"/>

    <!-- Whether the lock screen is up. -->
    <method name="DeviceLocked">
      <arg direction="out" name="locked" type="b"/>
    </method>
  </interface>
</node>
