<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  Runtime permissions without a portal, for every app in its own ATL Flatpak
  (docs/hardening-roadmap.md, phase 4). Same rules for changes as
  de.nexumia.atl.Installer: the interface only grows and Version says how far.

  The caller is the app whose sandbox makes the call. permission is an Android
  permission from the table in permissions.c or ATL's own "atl.google-services";
  others fail with InvalidArgs, and callers outside an ATL app Flatpak with
  AccessDenied. A permission the APK does not request is always "no".

  Version 1: Check and Request.
  Version 3: Review (version 2 is OpenAppInfo, #88).
-->
<node>
  <interface name="de.nexumia.atl.Permissions">
    <property name="Version" type="u" access="read"/>

    <!-- The stored answer without asking: "yes", "no" or "ask" (not answered yet). -->
    <method name="Check">
      <arg direction="in" name="permission" type="s"/>
      <arg direction="out" name="answer" type="s"/>
    </method>

    <!--
      Asks the user with the desktop's access dialog unless the answer is already
      "yes" or the user said no twice, stores it, and returns "yes" or "no".
    -->
    <method name="Request">
      <arg direction="in" name="permission" type="s"/>
      <arg direction="out" name="answer" type="s"/>
    </method>

    <!--
      For apps made for Android before 6 (target SDK or SDK_INT below 23), which never ask:
      once, one review of the caller's dangerous permissions, each off by default, stored like
      the other answers. Returns the answers ("yes" or "no") of the reviewed permissions the APK
      requests; after the review, without a dialog.
    -->
    <method name="Review">
      <arg direction="out" name="answers" type="a{ss}"/>
    </method>
  </interface>
</node>
