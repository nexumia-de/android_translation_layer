# ~/.config/systemd/user/atl-pulse-norecord.service: the pulse server
# without recording for ATL apps (atl-pulse-norecord.conf)
[Unit]
Description=PulseAudio server without recording for Android apps (ATL)
Requires=pipewire.service
After=pipewire.service

[Service]
RuntimeDirectory=atl-pulse-norecord
RuntimeDirectoryPreserve=no
ExecStart=/usr/bin/pipewire-pulse -c atl-pulse-norecord.conf
Restart=on-failure

[Install]
WantedBy=default.target
